#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.dnsCap/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
knot-sbom.pcs: software bill of materials of Knot DNS, BISOS's authoritative DNS server
(decision of 2026-10-10, bisos-pip/pals/palsWithBcm README.org <<1.2>>).
It installs Debian's knot and knot-dnsutils, then publishes BISOS's generated knot.conf
and zone files (bisos.dnsCap.knot_csu.fullUpdate), tinydns-style. Debian's knot.service
is used as is: no unit is authored here.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.dnsCap import knot_csu
from bisos.dnsCap import knotInfo as knotInfoMod
from bisos.dnsCap.knotInfo import knotInfo

ap = pkgsSeed.aptPkg


def knotDnsSetup():
    """BISOS's knot.conf and zones, published and serving. Not an apt package.

    Registered in aptPkgsList as a func-bearing pseudo-package, so sbom_csu's
    aptPkgs_update() calls this instead of apt-get install. Its gate can never be
    true, so this runs on *every* sbom_fullUpdate --- which is fine: fullUpdate
    installs and reloads only what changed, like re-running tinydns-data.
    Ordering in aptPkgsList is load-bearing: it must come after ap("knot").
    """
    outcome = knot_csu.fullUpdate(b.op.Outcome())
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


aptPkgsList = [ap(pkg) for pkg in knotInfo.debPkgs] + [
    ap("knotDnsSetup", func=knotDnsSetup),
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        zones = ", ".join(f"{d}." for d in knotInfoMod.zoneSpecFuncs)
        descriptionStr = f"""\
** Scope: Knot DNS -- BISOS's authoritative DNS server, run tinydns-style:
   BISOS data -> generated zone files -> kzonecheck -> knotc zone-reload.

** What this installs:
  1) apt packages: {", ".join(knotInfo.debPkgs)} (Debian's knot account and knot.service).
  2) The knotDnsSetup pseudo-package (knotDns.cs -i knotFullUpdate):
     - zone files under {knotInfo.zonesDir}: {zones}
     - {knotInfo.confFile} (Debian's original kept as knot.conf.debian)
     - knot.service enabled and running, listening on {knotInfo.listenAddr}

** Stateless by configuration: zonefile-load: whole, journal-content: none,
   zonefile-sync: -1. Never edit the running server or the installed files:
   change the data or the generator, then re-run.

** What this does NOT do:
  - It installs no resolver. Names under {zones} resolve only by asking Knot
    directly (knotDns.cs -i knotQuery) until a resolver stubs them to {knotInfo.listenIp}.
  - No DNSSEC and no zone transfers yet.

       knot-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Knot DNS -- sbom Examples*')
    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("knot-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal("knotc --version")
    literal("systemctl status knot.service")
    literal("knotDns.cs -i knotStatus")
    literal("knotDns.cs -i knotQuery kafka.here")

    cs.examples.menuChapter('*End-Of Knot DNS -- sbom Examples*')
    return cmndOutcome
