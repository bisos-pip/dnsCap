#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.dnsCap/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
unbound-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
bedrock: A capability other capabilities are built on --- not a Service Component of its own.
         Unbound is this platform's resolver: every lookup, and .intra via Knot.
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle is the sbom alone, as with postgres-cbs.pcs and knot-cbs.pcs. Debian's
unbound.service is used as is; unbound-sbom.pcs publishes its configuration and then
switches this host's resolv.conf to it --- only after Unbound answers.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="bedrock",
    loader=None,
    sbom="unbound-sbom.pcs",
    assemble=None,
    materialize=None,
)

cba_sysd_seed.setup(
    sysdUnitsList=[],
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
