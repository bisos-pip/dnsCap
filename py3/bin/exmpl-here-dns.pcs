#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for Processing Git Orgs and Repos (github)
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.capDns import capDns_seed #  noqa: F401  # type: ignore[unused-import] _atExit_

from bisos.capDns import capDns_seedInfo
cntrlInfo = capDns_seedInfo.cmndsControlInfo

cntrlInfo.brand = capDns_seedInfo.GitProviderBrand.Github
cntrlInfo.serverConfigPath = "~/credentials/githubHosts.cfg"
cntrlInfo.serverConfigTag = "default"

cntrlInfo.gitAccessType = capDns_seedInfo.GitAccessType.Anon
# For authenticated cloning, flip to Auth and pick a method + ssh acct:
# cntrlInfo.gitAccessType = capDns_seedInfo.GitAccessType.Auth
# cntrlInfo.gitAuthAccessMethod = capDns_seedInfo.GitAuthAccessMethod.Ssh
# cntrlInfo.gitAccessAcct = "github-mohsen"   # Host alias in ~/.ssh/config

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("capDns_reposList",  args="bisos-pip", doContinue=True),
    csCmnd("capDns_reposClone",
           pars=collections.OrderedDict([("destBaseDir", "~/capDnsClone/github/anon")]),
           args="bisos-pip", doContinue=True),
    csCmnd("capDns_clone",
           pars=collections.OrderedDict([("destBaseDir", "~/capDnsClone/github/anon")]),
           args="bisos-pip/capDns", doContinue=True),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)

def examples_pcs() -> None:
    od = collections.OrderedDict
    cmnd = cs.examples.cmndEnter
    # literal = cs.examples.execInsert

    csName = seedsLib.seededCsxuInfo.seedOfThisPlant

    cs.examples.menuChapter(f'*Seed Extensions*')

    cs.examples.menuChapter('= Sample  Module  Commands=')

    uploadPars = od([('upload', "example")])
    cmnd('targetRun', csName=csName, pars=uploadPars , args="""localhost""")
