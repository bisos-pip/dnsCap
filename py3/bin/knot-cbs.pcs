#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.dnsCap/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
knot-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
bedrock: A capability other capabilities are built on --- not a Service Component of its own.
         Knot DNS serves the names (here., and later the PALS zones) every other
         capability is reached by.
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle is the sbom alone, as with postgres-cbs.pcs. There is no assemble step and no
systemd unit authored here: Debian's knot.service is used as is, and knot-sbom.pcs
publishes its configuration and zones.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="bedrock",
    loader=None,
    sbom="knot-sbom.pcs",
    assemble=None,
    materialize=None,
)

cba_sysd_seed.setup(
    sysdUnitsList=[],
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
