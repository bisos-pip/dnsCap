#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.dnsCap/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
unbound-sbom.pcs: software bill of materials of Unbound, BISOS's local resolver
(decision of 2026-10-10, bisos-pip/pals/palsWithBcm README.org <<1.2>>).
It installs Debian's unbound (and knot-dnsutils, for kdig), then publishes bisos.conf,
switches this host's resolv.conf to Unbound --- only after Unbound answers --- and turns
Firefox's and Chrome/Chromium's DNS-over-HTTPS off (bisos.dnsCap.unbound_csu.fullUpdate).
Debian's unbound.service is used as is. unboundDns.cs -i resolverRevert undoes the switch.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.dnsCap import unbound_csu
from bisos.dnsCap.unboundInfo import unboundInfo
from bisos.dnsCap.knotInfo import knotInfo

ap = pkgsSeed.aptPkg


def unboundDnsSetup():
    """bisos.conf published, Unbound answering, this host switched to it. Not an apt package.

    Registered in aptPkgsList as a func-bearing pseudo-package, so sbom_csu's
    aptPkgs_update() calls this instead of apt-get install. Its gate can never be
    true, so this runs on *every* sbom_fullUpdate --- which is fine: each step installs
    only what changed. Ordering in aptPkgsList is load-bearing: after ap("unbound").
    """
    outcome = unbound_csu.fullUpdate(b.op.Outcome())
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


aptPkgsList = [ap(pkg) for pkg in unboundInfo.debPkgs] + [
    ap("unboundDnsSetup", func=unboundDnsSetup),
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        i = unboundInfo
        stubs = ", ".join(f"{z}." for z in i.stubZones)
        descriptionStr = f"""\
** Scope: Unbound -- BISOS's local resolver, mode={i.mode.value}, listening on {", ".join(i.listenAddrs)}.
   {stubs} is stubbed to Knot ({knotInfo.listenAddr}). .here stays in /etc/hosts.

** What this installs and changes, in order (unboundDns.cs -i unboundFullUpdate):
  1) apt packages: {", ".join(i.debPkgs)}.
  2) {i.confFile}: checked with unbound-checkconf (rolled back if it fails),
     unbound restarted, then it must answer for {i.healthCheckName}.
  3) Only then: NetworkManager dns=none ({i.nmConfFile}) and its dispatcher
     ({i.nmDispatcherFile}, company/VPN domains -> their own DNS servers),
     and {i.resolvConf} -> 127.0.0.1 (original kept as {i.resolvConfOrig}).
  4) Browsers: {i.firefoxPolicies} (DNSOverHTTPS key merged in) and
     {", ".join(str(p) for p in i.chromePolicyFiles)}: DNS-over-HTTPS off.
     {i.firefoxCanary} answers NXDOMAIN, for Firefoxes without the policy.

** Undo: unboundDns.cs -i resolverRevert   (Unbound and the browser policies stay)

** Known trade-off: with its DNS-over-HTTPS off, Firefox does not use Encrypted Client
   Hello. A local DoH endpoint on Unbound (needs the platform CA) is the planned fix.

       unbound-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Unbound -- sbom Examples*')
    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("unbound-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal("systemctl status unbound.service")
    literal("unboundDns.cs -i unboundStatus")
    literal("unboundDns.cs -i unboundQuery debian.org")
    literal("cat /etc/resolv.conf")

    cs.examples.menuChapter('*Undo*')
    literal("unboundDns.cs -i resolverRevert")

    cs.examples.menuChapter('*End-Of Unbound -- sbom Examples*')
    return cmndOutcome
